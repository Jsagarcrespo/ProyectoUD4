<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.VentanaRefugio">
  <grid id="principal" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="10" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints><xy x="20" y="20" width="520" height="360"/></constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="item1" class="javax.swing.JLabel">
        <constraints><grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="DATOS DEL REFUGIO"/></properties>
      </component>
      <component id="item2" class="javax.swing.JLabel">
        <constraints><grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Nombre"/></properties>
      </component>
      <component id="item3" class="javax.swing.JLabel">
        <constraints><grid row="1" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Razón social"/></properties>
      </component>
      <component id="item4" class="javax.swing.JTextField" binding="nombreField">
        <constraints><grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
      </component>
      <component id="item5" class="javax.swing.JTextField" binding="razonSocialField">
        <constraints><grid row="2" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
      </component>
      <component id="item6" class="javax.swing.JLabel">
        <constraints><grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="CIF"/></properties>
      </component>
      <component id="item7" class="javax.swing.JLabel">
        <constraints><grid row="3" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Dirección"/></properties>
      </component>
      <component id="item8" class="javax.swing.JTextField" binding="cifField">
        <constraints><grid row="4" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
      </component>
      <component id="item9" class="javax.swing.JTextField" binding="direccionField">
        <constraints><grid row="4" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
      </component>
      <component id="item10" class="javax.swing.JLabel">
        <constraints><grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Teléfono"/></properties>
      </component>
      <component id="item11" class="javax.swing.JLabel">
        <constraints><grid row="5" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Email"/></properties>
      </component>
      <component id="item12" class="javax.swing.JTextField" binding="telefonoField">
        <constraints><grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
      </component>
      <component id="item13" class="javax.swing.JTextField" binding="emailField">
        <constraints><grid row="6" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
      </component>
      <component id="item14" class="javax.swing.JLabel">
        <constraints><grid row="7" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Fecha apertura (dd/MM/yyyy)"/></properties>
      </component>
      <component id="item15" class="javax.swing.JTextField" binding="fechaAperturaField">
        <constraints><grid row="8" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
      </component>
      <component id="item16" class="javax.swing.JButton" binding="guardarButton">
        <constraints><grid row="9" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Guardar"/></properties>
      </component>
      <component id="item17" class="javax.swing.JButton" binding="cerrarButton">
        <constraints><grid row="9" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Cerrar"/></properties>
      </component>
    </children>
  </grid>
</form>
