<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.VentanaPrincipal">
  <grid id="principal" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints><xy x="20" y="20" width="500" height="400"/></constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="item1" class="javax.swing.JLabel">
        <constraints><grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="GESTIÓN DE REFUGIO DE ANIMALES"/></properties>
      </component>
      <component id="item2" class="javax.swing.JLabel">
        <constraints><grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Datos del refugio"/></properties>
      </component>
      <scrollpane id="listadoScroll">
        <constraints><grid row="2" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="listado" class="javax.swing.JTextArea" binding="datosRefugio">
            <constraints/>
            <properties><editable value="false"/><lineWrap value="true"/><wrapStyleWord value="true"/></properties>
          </component>
        </children>
      </scrollpane>
      <component id="item3" class="javax.swing.JButton" binding="refugioButton">
        <constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Refugio"/></properties>
      </component>
      <component id="item4" class="javax.swing.JButton" binding="animalesButton">
        <constraints><grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Animales"/></properties>
      </component>
      <component id="item5" class="javax.swing.JButton" binding="adoptantesButton">
        <constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Adoptantes"/></properties>
      </component>
      <component id="item6" class="javax.swing.JButton" binding="adopcionesButton">
        <constraints><grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Adopciones"/></properties>
      </component>
      <component id="item7" class="javax.swing.JButton" binding="exportarButton">
        <constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Exportar datos"/></properties>
      </component>
      <component id="item8" class="javax.swing.JButton" binding="metadatosButton">
        <constraints><grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Metadatos"/></properties>
      </component>
      <component id="item9" class="javax.swing.JButton" binding="estadisticasButton">
        <constraints><grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Estadísticas"/></properties>
      </component>
      <component id="item10" class="javax.swing.JButton" binding="salirButton">
        <constraints><grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Salir"/></properties>
      </component>
    </children>
  </grid>
</form>
